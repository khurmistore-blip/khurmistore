# Block direct HTTP access to server-side logs and order exports (PII) —
# these must only be read via SSH/SFTP, never over the web.
<FilesMatch "\.(log|csv)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Serve index.php as the homepage; index.html is legacy only
DirectoryIndex index.php index.html

RewriteEngine On

# Redirect legacy index.html to real homepage (index.php)
RewriteRule ^index\.html$ / [R=301,L]

# Serve the dynamic sitemap.php at /sitemap.xml (internal rewrite, no redirect —
# Google Search Console requires the sitemap URL itself to end in .xml)
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Redirect deleted fake-catalog demo pages (48 hardcoded Unsplash products) to
# the real Supabase-backed store
RewriteRule ^products\.html$ /index.php [R=301,L]
RewriteRule ^categorias\.html$ /index.php [R=301,L]
RewriteRule ^product-details\.html$ /index.php [R=301,L]
RewriteRule ^categoria\.html$ /index.php [R=301,L]

# 301: missing blog post → nearest existing equivalent
RewriteRule ^blog-auriculares-bluetooth-no-conectan/?$ https://khurmistore.es/blog-como-conectar-auriculares-bluetooth [R=301,L]

# 301: founder-bio post removed (flagged as manufactured legitimacy) → blog index
RewriteRule ^blog-khurram-shahzad-fundador-khurmistore\.html$ /blog.html [R=301,L]

# Regla para categorías amigables: /category/slug -> categoria.php?cat=slug
# (categoria.html, la demo estática, fue eliminada; esto apunta a la página real)
RewriteRule ^category/([^/]+)/?$ categoria.php?cat=$1 [L,QSA]

# Regla para productos amigables: /producto/slug -> redirige a la tienda real
# (product-details.html fue eliminado; producto.php no tiene lookup por slug)
RewriteRule ^producto/([^/]+)/?$ /index.php [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]

# Compresión Gzip (mod_deflate)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE font/x-woff
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Caché del navegador (mod_expires)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML — short TTL so updates propagate quickly
    ExpiresByType text/html "access plus 1 hour"

    # CSS y JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Imágenes
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fuentes
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Cache-Control headers (complements mod_expires)
<IfModule mod_headers.c>
    # Static assets — immutable for 1 year
    <FilesMatch "\.(css|js|woff|woff2|ttf|otf|svg|jpg|jpeg|png|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # HTML — revalidate every visit
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

# UTF-8 charset for text files
AddDefaultCharset UTF-8
AddType "text/plain; charset=utf-8" .txt
