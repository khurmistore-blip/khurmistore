# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Supabase — anon key is safe to expose (protected by RLS), service key is NOT.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WA_ACCESS_TOKEN=your-whatsapp-access-token
WA_API_VERSION=v25.0
WA_TEMPLATE_LANG=es

# Store display config
STORE_NAME=KhurmiStore
CURRENCY_SYMBOL=€
WHATSAPP_ORDER_NUMBER=34600000000

# BigBuy (sync_products.php)
BIGBUY_API_KEY=your-bigbuy-api-key
BIGBUY_SANDBOX=true

# Anthropic (rewrite_descriptions.php)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Order notifications (save_order.php / notify_shipped.php)
OWNER_EMAIL=owner@example.com
OWNER_PHONE=+34600000000
CALLMEBOT_KEY=your-callmebot-key

# Stripe (stripe_checkout.php / stripe_return.php / stripe_webhook.php)
STRIPE_SECRET_KEY=sk_live_or_sk_test_your-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_your-publishable-key
# From Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
